import requests
from bs4 import BeautifulSoup

search_term = "external harddrive"
url = f"https://mdcomputers.in/?route=product/search&search={search_term.replace(' ', '+')}"

headers = {
    "User-Agent": "Mozilla/5.0"
}

response = requests.get(url, headers=headers)
soup = BeautifulSoup(response.text, "html.parser")

products = soup.select(".product-layout")

if not products:
    print("No products found.")

for product in products:
    name = product.select_one(".caption h4")
    price = product.select_one(".price")
    link = product.select_one(".caption h4 a")

    print("Product:", name.text.strip() if name else "N/A")
    print("Price:", price.text.strip() if price else "N/A")
    print("Link:", link["href"] if link else "N/A")
    print("-" * 50)
